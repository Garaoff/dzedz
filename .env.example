# Bot SMC/ICT v2 — Configuration d'environnement
# Copie ce fichier en .env et remplis tes valeurs réelles
# JAMAIS de .env dans git — ajoute .env à .gitignore

# =============================================================================
# BROKER — Choisis OANDA (Linux/Mac), MT5 (Windows), ou CCXT (crypto)
# =============================================================================

BROKER_TYPE=oanda    # oanda | mt5 | ccxt

# OANDA (https://developer.oanda.com) — Works on Linux, Mac, Windows
# Supports: XAU_USD (Or), NAS100_USD (NASDAQ), BTC_USD (Bitcoin)
OANDA_API_KEY=YOUR_OANDA_API_KEY_HERE
OANDA_ACCOUNT_ID=YOUR_ACCOUNT_ID_HERE
OANDA_ENVIRONMENT=practice    # practice (demo) | live (réel)

# MT5 (Windows seulement)
# Supports: XAUUSD, NAS100, BTCUSD
MT5_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
MT5_LOGIN=YOUR_MT5_LOGIN
MT5_PASSWORD=YOUR_MT5_PASSWORD
MT5_SERVER=YOUR_MT5_SERVER
MT5_TIMEOUT=10000

# CCXT / Crypto (Binance, Bybit, etc.)
# Only supports: BTCUSD (BTC/USDT) — XAUUSD et NAS100 sont CFD, pas sur crypto spot
CCXT_EXCHANGE=binance    # binance | bybit | kraken | etc.
CCXT_API_KEY=YOUR_EXCHANGE_API_KEY
CCXT_SECRET=YOUR_EXCHANGE_SECRET
CCXT_TESTNET=true        # true pour test, false pour réel

# =============================================================================
# SYMBOLES — 3 symboles : XAUUSD (priorité 1), NAS100, BTCUSD
# =============================================================================

TRADING_SYMBOLS=XAUUSD,NAS100,BTCUSD    # Symboles séparés par virgules
# XAUUSD = Or (le plus important) — OANDA: XAU_USD, MT5: XAUUSD
# NAS100 = NASDAQ Index — OANDA: NAS100_USD, MT5: NAS100
# BTCUSD = Bitcoin — OANDA: BTC_USD, MT5: BTCUSD, CCXT: BTC/USDT

ENTRY_TIMEFRAME=M1       # Timeframe d'exécution — ICT nécessite M1
HTF_TIMEFRAME=H4         # Timeframe supérieur pour le biais ICT

# =============================================================================
# RISQUE — Règle 5 : un seul verrou
# =============================================================================

CAPITAL=10000            # Capital en devise du compte
MAX_RISK_PER_TRADE_PCT=1.0   # 1% max par trade — conservateur
ABSOLUTE_MAX_RISK_PCT=5.0    # 5% plafond absolu — JAMAIS dépassé
MIN_LOT_SIZE=0.01            # Lot minimum broker

# =============================================================================
# MODE
# =============================================================================

TRADING_MODE=demo         # demo | live | backtest
# demo = paper trading sur compte demo
# live = trading réel sur compte live — ATTENTION !
# backtest = simulation sur historique uniquement

# =============================================================================
# KILL SWITCH — Arrêt d'urgence
# =============================================================================

MAX_DAILY_LOSS_PCT=3.0   # Arrêt automatique si -3% par jour
MAX_CONCURRENT_TRADES=3  # Maximum trades ouverts simultanés (1 par symbole recommandé)
MAX_TRADES_PER_DAY=10    # Maximum trades par jour
MAX_TRADES_PER_SYMBOL_PER_DAY=3  # Maximum trades/jour par symbole

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/bot.log    # Fichier de log
